# =============================================================================
# SentinelScrape — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your actual Bright Data credentials.
# The scraper will refuse to start if these are left as placeholders.

# Bright Data Scraper Studio API token (from your Bright Data dashboard)
BRIGHT_DATA_API_TOKEN=your_actual_api_token_here

# Bright Data collector/scraper ID
BRIGHT_DATA_COLLECTOR_ID=your_actual_collector_id_here
